{% extends "layouts/base.njk" %}

{% block content %}
<h1 style='padding-bottom:0;margin-bottom:0'>{{ title }}</h1>
<small style='color:gray'>{{ date | date("MMMM d, yyyy") }}</small>
<small style='color:gray;float:right;'><i class="fas fa-book-open"></i> {{ content | readingTime }}</small>
<small style='color:gray;float:right;margin-right:10px;'><i class="fas fa-eye"></i>&nbsp;<span id="views"></span></small>
<hr/>
<script>
  async function view() {
    try {
      const title = '{{ title  | safe }}';
      const post = "writing-" + title.toLowerCase().replace(/ /g, '-');
      const url = "https://counterapi.com/api/akashthakare/"+ post +"/hit";
      const response = await fetch(url);
      const data = await response.json();
      document.getElementById("views").textContent = data.value;
    } catch (error) {
      console.error("Error fetching views:", error);
    }
  }
  view();
</script>
{% endblock %}
